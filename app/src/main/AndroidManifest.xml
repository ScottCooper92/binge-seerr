<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        A normal permission: the television's address hand-off (#323) reads its own LAN address
        from the active network's link properties. The phone-to-TV traffic is LAN traffic, which on
        SDK 37 needs ACCESS_LOCAL_NETWORK once this app targets 37 (#732); targeting 36, it is
        granted automatically, so it is not declared or requested here.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Reaching a Seerr on the user's own network (a private IP, .local, .lan, a single-label name) is
        refused from SDK 37 unless this is granted, and an app targeting 37 no longer gets it
        automatically. Nothing changes below 37; setup asks for it when the address is a local one.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!--
        Both required="false", as Binge declares them, so the one APK serves phones and televisions.
        Without the touchscreen declaration Play assumes a touchscreen is required and hides the app
        from every TV; the leanback category alone does not override that default.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
        Package visibility: whether Binge answers the title link the SDK builds
        (CompanionManifest.hostTitleUri, scheme HOST_TITLE_SCHEME), and
        whether Binge is installed at all (the Hub tile, #469) — a plain getPackageInfo() on its
        package name is invisible without this on a targetSdk this high.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="binge" />
        </intent>
        <package android:name="com.cooper.binge.app" />
    </queries>

    <!--
        Cleartext is allowed because a self-hosted Seerr on a LAN or a tailnet is plain HTTP far
        more often than not, and refusing it would refuse most real servers. The setup screen
        warns when an http:// address names a PUBLIC host, which is the case that actually leaks.
    -->
    <application
        android:name=".SeerrApp"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/companion_label"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
            Crashlytics starts switched off, so nothing is sent before CrashReportingSwitch has read the
            user's preference; it turns collection on from there, and never on a debug build.
        -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />

        <!--
            WorkManager's own initializer is removed so it starts through SeerrApp's configuration,
            whose worker factory is Hilt's: the poll worker takes its collaborators by injection.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
            The launch theme is the splash one; installSplashScreen() swaps in Theme.Seerr as it
            hands over, so Theme.Seerr stays the activity's real theme.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Seerr.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The hand-off behind CAPABILITY_ADVANCED_OPTIONS. Binge resolves it by this action and
            this package (the DEFAULT category is what makes an implicit Intent resolve to it) and
            starts it for a result. exported="true" makes it reachable by every app, so the
            Activity checks its caller with the SDK's HandOffPolicy before it reads the extras,
            as the Service below does with HostPolicy.
        -->
        <activity
            android:name=".AdvancedRequestActivity"
            android:exported="true"
            android:label="@string/advanced_title"
            android:theme="@style/Theme.Seerr">
            <intent-filter>
                <action android:name="com.binge.companion.ADVANCED_REQUEST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            The host's "manage" affordance. Binge resolves it by this action and this package and
            starts it for a result, which is what gives this app a callingPackage to check; it has
            no window of its own and opens MainActivity once the caller is admitted.

            Not an intent filter on MainActivity: that one is singleTask, and an Activity launched
            into its own task has no calling package, so the check would refuse every host.
        -->
        <activity
            android:name=".SettingsHandOffActivity"
            android:exported="true"
            android:theme="@style/Theme.SeerrHandOff">
            <intent-filter>
                <action android:name="com.binge.companion.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            The phone's end of the TV address hand-off (#323). The page a television serves links
            here from the phone's browser, so it is exported and BROWSABLE, and matches only the
            tv-handoff host of this app's own scheme: the notification links on MainActivity stay
            unreachable from a web page. What guards it is in SendAddressViewModel - a LAN-only
            target, and nothing sent without the user's tap.

            Deliberately not singleTask: the ViewModel reads its target once, from the intent that
            created it, so a second link must get a new instance. singleTask would hand it to
            onNewIntent and leave the sheet pointing at the first TV's port and token.
        -->
        <activity
            android:name=".SendAddressActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.SeerrSendAddress">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="tv-handoff"
                    android:scheme="seerr-companion" />
            </intent-filter>
        </activity>

        <!--
            exported="true" is the integration surface: the host reaches this Service with
            bindService, and what guards it is the caller policy in SeerrCompanionService, not the
            manifest. android:process is deliberately absent so the Service runs under this app's
            own uid, which is what the host's certificate check verifies.

            The meta-data is read by the host WITHOUT binding, so it can list this app and decide
            whether the two can parse each other before any process of ours starts. The keys are
            CompanionManifest's; a typo here reads as "declares no contract".
        -->
        <service
            android:name=".service.SeerrCompanionService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.binge.companion.REQUEST" />
            </intent-filter>

            <meta-data
                android:name="com.binge.companion.name"
                android:value="@string/companion_label" />
            <meta-data
                android:name="com.binge.companion.icon"
                android:resource="@drawable/ic_companion" />
            <meta-data
                android:name="com.binge.companion.majors"
                android:value="1" />
        </service>
    </application>

</manifest>
