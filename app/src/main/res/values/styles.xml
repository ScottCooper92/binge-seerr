<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The window before Compose paints. Light on a phone in light mode, dark in dark mode
        (values-night), and dark with a black window on a television (values-television), so the
        first frame agrees with the theme each shell wears rather than flashing white under it.
    -->
    <style name="Theme.Seerr" parent="@android:style/Theme.Material.Light.NoActionBar" />

    <!--
        The settings hand-off never paints: it admits its caller and opens the hub from onCreate.
        A translucent window is what stops a frame of the theme above flashing on the way through.
    -->
    <style name="Theme.SeerrHandOff" parent="@android:style/Theme.Translucent.NoTitleBar" />
</resources>
