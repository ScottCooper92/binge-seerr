<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The window before Compose paints. Light on a phone, and dark with a black window on a
        television (values-television), so the first frame agrees with the theme each shell wears
        rather than flashing white under the TV theme.
    -->
    <style name="Theme.Seerr" parent="@android:style/Theme.Material.Light.NoActionBar" />

    <!--
        The settings hand-off never paints: it admits its caller and opens the hub from onCreate.
        A translucent window is what stops a frame of the theme above flashing on the way through.
    -->
    <style name="Theme.SeerrHandOff" parent="@android:style/Theme.Translucent.NoTitleBar" />

    <!--
        The launch theme. Android draws a splash of its own only from API 31, and this app runs on
        televisions that lag OS versions badly, so on much of that install base nothing was shown
        between tapping the icon and the first frame. core-splashscreen backports it to API 21+.

        Black rather than a brand colour: Theme.Seerr's window is black on a television and the app
        opens onto a dark surface either way, so the mark sits on the surface the content will
        occupy and the hand-off has nothing to flash between. Declared here and not in
        values-television: postSplashScreenTheme points at Theme.Seerr, which resolves to the
        television variant on a television by itself.
    -->
    <style name="Theme.Seerr.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_launcher_ring</item>
        <item name="postSplashScreenTheme">@style/Theme.Seerr</item>
    </style>
</resources>
