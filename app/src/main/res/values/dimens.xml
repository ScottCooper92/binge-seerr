    <dimen name="setup_backdrop_height">220dp</dimen>
    <!-- The hub's side padding when it is the list pane. Deliberately unqualified, unlike the design
         system's screen_content_inset: that one scales with the window (16/24/32dp), and a pane is a
         fraction of the window, so an unfolded fold gave a phone-width pane a tablet's 32dp. -->
    <dimen name="hub_list_pane_inset">16dp</dimen>
