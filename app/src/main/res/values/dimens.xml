    <!-- The users list root's skeleton row: an avatar-leading ListRow, so ListRowSkeleton's 128dp
         poster-row default reads twice as tall as the row it stands in for. list_row_padding × 2
         (top + bottom) plus a titleMedium line, padding_xs and a bodySmall line — which happens to
         match avatar_size_md, since ListRow centres the avatar against that content column. -->
    <dimen name="users_row_skeleton_height">64dp</dimen>
    <!-- RequestDetailSkeleton's headline chip row (#373): BingeTag has no fixed width of its own
         (it sizes to its label), so the skeleton picks a plausible one for each of the two chips
         every request headline shows (media type, request status). -->
    <dimen name="request_skeleton_chip_width">72dp</dimen>
    <!-- The same skeleton's button plate inside the request card: the Review / Manage label sizes the
         real BingeTextButton, so this picks a plausible width for the longer of the two. -->
    <dimen name="request_skeleton_button_width">120dp</dimen>
    <!-- A job row's action slot: a button, a spinner and an outcome icon all sit in the same box,
