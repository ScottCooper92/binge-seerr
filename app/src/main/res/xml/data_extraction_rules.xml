<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing the app stores leaves the device through Android's own backup or a device-to-device transfer.

    allowBackup="false" in the manifest covers cloud backup, but on Android 12 and later it does not stop a
    device-to-device transfer on every device, so these rules say it for both, domain by domain.

    The connection still moves to a new device, through Block Store (auth/BlockStoreConnectionCarrier.kt), which
    is proved against the server before it is used. Block Store is Play services' own storage, so these rules do
    not reach it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
