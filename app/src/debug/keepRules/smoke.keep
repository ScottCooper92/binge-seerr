# Keeps for the device smoke's test code only (#2648). Debug-only, so the release APK does not carry them.
#
# The test APK resolves every class it does not define from the app's dex, and `-PminifyDebug`
# shrinks the app first. These are the classes the smoke test reaches that the app never does, found
# by diffing what the test APK references against what either APK defines:
#
#   apkanalyzer dex packages app-debug-androidTest.apk        (the `C` rows flagged `r`)
#   apkanalyzer dex packages --defined-only app-debug.apk app-debug-androidTest.apk
#
# The app is the Service side of the Binder, so the client half of gRPC and the test's flag fakes are
# not in it. An exact list, with the reason for each; do not widen it to a package.

# MockWebServer, in the test APK, uses these Kotlin facades; the app inlines or avoids them.
-keep class kotlin.collections.CollectionsKt { *; }
-keep class kotlin.text.StringsKt { *; }
-keep class kotlin.text.CharsKt { *; }

# The test is the Binder client: the app only serves.
-keep class io.grpc.ManagedChannel { *; }
-keep class io.grpc.binder.BinderChannelBuilder { *; }
-keep class com.binge.companion.contracts.request.v1.RequestServiceGrpcKt$RequestServiceCoroutineStub { *; }

# FlagsTestModule installs these fakes.
-keep class com.cooper.homelab.core.flags.FixedFeatureFlags { *; }
-keep class com.cooper.homelab.core.flags.NoRemoteFlagSource { *; }

# Hilt's test rule calls these interfaces' methods on the app's own generated Application, and the
# minified app has no caller of them, so R8 drops the methods:
# `NoSuchMethodError: No interface method componentManager() in GeneratedComponentManagerHolder`.
# A class-level diff of the two APKs cannot see a missing method; the lane's logcat does.
-keepclassmembers interface dagger.hilt.internal.GeneratedComponentManagerHolder {
    dagger.hilt.internal.GeneratedComponentManager componentManager();
}

# The Hilt test root's generated code, in the test APK, implements these two interfaces, which live in
# the app's inputs. The app never uses them, so R8 removes them (they are in the app's `usage.txt`) and
# the test Application dies in `Class.newInstance` with
# `NoClassDefFoundError: dagger.hilt.internal.TestSingletonComponentManager`. Found by intersecting the
# app's `usage.txt` (what R8 removed) with the type descriptors in the test APK's dex.
-keep class dagger.hilt.internal.TestSingletonComponent { *; }
-keep class dagger.hilt.internal.TestSingletonComponentManager { *; }

# The Hilt test root names the app's whole graph. `TestComponentDataSupplier` loads, by name, every
# module and entry point the app's graph declares, and the test's generated components implement
# Dagger's runtime interfaces. The app's own build needs none of them at runtime once it is minified,
# so R8 removes them, and the next one the test reaches fails the run one class at a time
# (`NoClassDefFoundError: ...FragmentGetContextFix$FragmentGetContextFixEntryPoint`). These were
# found by intersecting the app's `usage.txt` with the type descriptors in the test APK's dex, which
# listed them all at once. Debug-only, so release shrinks as before.
-keep class dagger.hilt.** { *; }
-keep class dagger.internal.Factory { *; }
-keep class dagger.MembersInjector { *; }
-keep class **.HiltWrapper_* { *; }
-keep class **_HiltModules { *; }
-keep class **_HiltModules$* { *; }
-keep class **_HiltModule { *; }
-keep class **_AssistedFactory { *; }

# MockWebServer, in the test APK, names OkHttp's WebSocket classes from its upgrade handling.
-keep class okhttp3.WebSocketListener { *; }
-keep class okhttp3.internal.ws.** { *; }

# Methods the test calls that the minified app never does, so R8 removes them: the test is the Binder
# client and drives MockWebServer. Found by intersecting the method references in the test APK's dex
# (`dexdump -d`) with the members R8 listed as removed in the app's `usage.txt`; no field, constructor
# or class is left on that list. Exact methods, not packages. Debug-only. The return type is `***`:
# `**` does not match a primitive, so a `void` method would not be kept.
-keepclassmembers class androidx.tracing.Trace { *** forceEnableAppTracing(...); }

# The host side of the contract: the app answers these messages, the test builds them.
-keepclassmembers class com.binge.companion.contracts.request.v1.GetStatusRequest { *** newBuilder(...); }
-keepclassmembers class com.binge.companion.contracts.request.v1.GetStatusRequest$Builder { *** setMedia(...); }
-keepclassmembers class com.binge.companion.contracts.request.v1.GetStatusResponse { *** getStatus(...); }
-keepclassmembers class com.binge.companion.contracts.request.v1.HandshakeRequest { *** newBuilder(...); }
-keepclassmembers class com.binge.companion.contracts.request.v1.HandshakeRequest$Builder { *** setHost(...); }
-keepclassmembers class com.binge.companion.contracts.request.v1.HandshakeResponse {
    *** getCapabilitiesCount(...);
    *** getProviderName(...);
}
-keepclassmembers class com.binge.companion.contracts.v1.HostInfo { *** newBuilder(...); }
-keepclassmembers class com.binge.companion.contracts.v1.HostInfo$Builder {
    *** setPackageName(...);
    *** setVersionCode(...);
    *** setVersionName(...);
}
-keepclassmembers class com.cooper.homelab.core.flags.Flags$Companion { *** of(...); }
-keepclassmembers class io.grpc.binder.AndroidComponentAddress { *** forRemoteComponent(...); }
-keepclassmembers class kotlinx.coroutines.CancellableContinuation { *** resume(...); }

# MockWebServer reaches into OkHttp's internals and Okio.
-keepclassmembers class okhttp3.Headers$Builder { *** add(...); }
-keepclassmembers class okhttp3.internal.Internal { *** addHeaderLenient(...); }
-keepclassmembers class okhttp3.internal._UtilJvmKt { *** closeQuietly(...); }
-keepclassmembers class okhttp3.internal.concurrent.TaskQueue { *** idleLatch(...); }
-keepclassmembers class okhttp3.internal.concurrent.TaskRunner { *** activeQueues(...); }
-keepclassmembers class okhttp3.internal.concurrent.TaskRunner$RealBackend { *** shutdown(...); }
-keepclassmembers class okhttp3.internal.http2.Http2Connection {
    *** pushStream(...);
    *** setSettings(...);
}
-keepclassmembers class okhttp3.internal.http2.Http2Stream {
    *** enqueueTrailers(...);
    *** takeHeaders$default(...);
    *** writeHeaders(...);
}
-keepclassmembers class okhttp3.internal.http2.Settings { *** clear(...); }
-keepclassmembers class okhttp3.internal.platform.Platform {
    *** getHandshakeServerNames(...);
    *** getServerSocketFactory(...);
}
-keepclassmembers class okio.Buffer { *** copyTo$default(...); }
-keepclassmembers class okio.BufferedSink {
    *** write(...);
    *** writeAll(...);
}
